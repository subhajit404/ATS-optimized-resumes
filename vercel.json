{
  "version": 2,
  "buildCommand": "npm --prefix ai-roadmap/Frontend install && npm --prefix ai-roadmap/Frontend run build",
  "outputDirectory": "ai-roadmap/Frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
